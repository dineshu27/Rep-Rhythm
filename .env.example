# Supabase Project Settings → API. Use a PUBLIC publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional cloud configuration. All browser tracking works without these values.
# AI is disabled by default. Enable only after explicit paid usage approval.
# Server-only values; never use NEXT_PUBLIC for these.
OPENAI_API_KEY=
AI_ENABLED=false
AI_PAID_USAGE_APPROVED=false
# See docs/ai-assistant.md for authenticated access and durable usage limits.
